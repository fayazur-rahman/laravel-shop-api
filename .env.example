# laravel-shop-api — environment contract
# Copy to .env for local runs ONLY. In containers/servers, inject these as real
# environment variables (real env vars take precedence over .env). Never commit .env.

# --- Application -------------------------------------------------------------
APP_NAME="Laravel Shop API"
# local | staging | production  (production makes `migrate` require --force)
APP_ENV=local
# REQUIRED. Generate once per environment:  php artisan key:generate --show
# Changing it logs everyone out and makes encrypted data unreadable.
APP_KEY=
# Comma-separated old keys, only during a planned APP_KEY rotation.
APP_PREVIOUS_KEYS=
# Never true in production (leaks stack traces).
APP_DEBUG=true
APP_URL=http://localhost

# --- Logging -----------------------------------------------------------------
# stderr = container-friendly (docker logs / CloudWatch). Use "single" for storage/logs/laravel.log.
LOG_CHANNEL=stderr
LOG_LEVEL=debug

# --- Database (MySQL) ---------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shop
DB_USERNAME=shop
DB_PASSWORD=change-me
# Seconds before a DB connect attempt gives up (fail fast instead of hanging).
DB_TIMEOUT=5

# --- Redis (cache + sessions + queue) -----------------------------------------
# phpredis = needs the PHP "redis" extension in the runtime image.
# predis   = pure-PHP alternative (would need: composer require predis/predis).
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
# Logical DBs: 0 = queue + sessions, 1 = cache
REDIS_DB=0
REDIS_CACHE_DB=1
# Seconds before a Redis connect/read gives up.
REDIS_TIMEOUT=2
REDIS_READ_TIMEOUT=2

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis

# --- Mail ---------------------------------------------------------------------
# log = emails are written to the log instead of sent (no SMTP needed).
# For real SMTP: MAIL_MAILER=smtp and fill MAIL_HOST/PORT/USERNAME/PASSWORD.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- File storage (product images) ---------------------------------------------
# local = storage/app/private on the box. s3 = AWS bucket below (adapter already installed).
FILESYSTEM_DISK=local
# On AWS, leave the keys EMPTY and use an IAM role (instance/task role).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
