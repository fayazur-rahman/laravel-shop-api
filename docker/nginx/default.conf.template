server {
   listen 80;
   server_name _;


    # Must be the SAME path as inside the app container: Nginx passes this path
    # to php-fpm, and php-fpm opens the file on ITS filesystem.
   root /var/www/html/public;
   index index.php;


    # Uploads: Laravel validates images at ≤ 2 MB; Nginx's default is 1 MB.
   client_max_body_size 4m;


    # Real file in public/ → serve it. Anything else → Laravel's front controller.
    location / {
       try_files $uri $uri/ /index.php?$query_string;
    }


    # Only the front controller is executed. Any other *.php → 404.
    location = /index.php {
       fastcgi_pass ${PHP_FPM_HOST}:9000;
       include fastcgi_params;
       fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
       fastcgi_param DOCUMENT_ROOT   $realpath_root;
       fastcgi_read_timeout 30s;
    }


    location ~ \.php$ {
        return 404;
    }


    # Never serve dotfiles (.env, .git, …) even if one slipped into public/.
    location ~ /\.(?!well-known) {
       deny all;
    }
}

